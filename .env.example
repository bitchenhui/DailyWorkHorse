# PushPlus：关注「pushplus 推送加」公众号 → 个人中心复制 token
PUSHPLUS_TOKEN=your_pushplus_token

# 大模型：支持 Anthropic 兼容（MiniMax）与 OpenAI 兼容
# MiniMax 示例：
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M3
# OpenAI / DeepSeek 示例：
# LLM_API_BASE=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 启用哪些分发平台，逗号分隔，留空为全部（wechat_mp,xhs）
# ENABLED_PLATFORMS=wechat_mp,xhs

# 各平台投递档位，目前仅实现 bundle（生成成稿包，人工一键发布）
# WECHAT_MP_TIER=bundle
# XHS_TIER=bundle

# 分发总览页地址，填入后会附在微信通知末尾方便手机直达
# PUBLIC_DRAFT_URL=https://<user>.github.io/wechatInforPush/
