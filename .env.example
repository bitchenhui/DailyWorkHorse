# PushPlus：关注「pushplus 推送加」公众号 → 个人中心复制 token
PUSHPLUS_TOKEN=your_pushplus_token

# 大模型：支持 Anthropic 兼容（MiniMax）与 OpenAI 兼容
# MiniMax 示例：
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M3
# OpenAI / DeepSeek 示例：
# LLM_API_BASE=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 启用哪些分发平台，逗号分隔，留空为全部（wechat_mp,xhs,xhs_video）
# 关掉平台会连带跳过它背后的信息源：只填 xhs_video 就不会调大模型，
# 只填 wechat_mp,xhs 就不会打行情接口。
# ENABLED_PLATFORMS=wechat_mp,xhs,xhs_video

# 各平台投递档位，目前仅实现 bundle（生成成稿包，人工一键发布）
# WECHAT_MP_TIER=bundle
# XHS_TIER=bundle
# XHS_VIDEO_TIER=bundle

# 分发总览页地址，填入后会附在微信通知末尾方便手机直达
# PUBLIC_DRAFT_URL=https://<user>.github.io/DailyWorkHorse/

# 本地反复试跑时，dist/ 会累积各平台目录，总览页列的是目录里现有什么。
# 想从干净状态开始就先删掉 dist/。

# 运行报告邮件（Actions 跑完后发送，成功/失败/空跑都会发）
# 163 邮箱：Settings → POP3/SMTP/IMAP → 开启 SMTP → 获取授权码（不是登录密码）
# MAIL_USERNAME=yourname@163.com
# MAIL_PASSWORD=你的163授权码
# MAIL_TO=yourname@163.com
# MAIL_FROM=可选，默认与 MAIL_USERNAME 相同；163 要求发件地址与登录账号一致
